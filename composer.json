{
    "name": "freddokresna/yii2-admin-fkresna",
    "description": "RBAC Auth manager for Yii2",
    "keywords": ["yii", "admin", "auth", "rbac"],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Freddo Kresna",
            "email": "freddokresna@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "yiisoft/yii2": "^2.0.55",
        "yiisoft/yii2-bootstrap5": "^2.0.51",
        "twbs/bootstrap-icons": "^1.13"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-phpbrowser": "^4.1",
        "codeception/module-yii2": "^1.1",
        "codeception/specify": "^2.0",
        "codeception/verify": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "mdm\\admin\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}